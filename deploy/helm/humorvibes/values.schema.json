{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy", "tag", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "tag": {"type": "string", "minLength": 1},
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "existingSecret": {"type": "string"},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingress", "egress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingress": {"type": "array"},
        "egress": {"type": "array"}
      }
    },
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "resources": {"type": "object"},
    "startupProbe": {"type": "object"},
    "livenessProbe": {"type": "object"},
    "readinessProbe": {"type": "object"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "llmDefault",
        "embeddingDefault",
        "ollamaHost",
        "ollamaModels",
        "ollamaEmbeddingModels",
        "maxRequestBytes",
        "maxResponseBytes",
        "maxBatchItems",
        "rateLimitPerMinute",
        "strictReadiness",
        "corsOrigins",
        "statsdHost",
        "statsdPort",
        "otelTracesEndpoint",
        "otelServiceName",
        "otelSampleRatio"
      ],
      "properties": {
        "llmDefault": {"type": "string"},
        "embeddingDefault": {"type": "string"},
        "ollamaHost": {"type": "string"},
        "ollamaModels": {"type": "string"},
        "ollamaEmbeddingModels": {"type": "string"},
        "maxRequestBytes": {"type": "string"},
        "maxResponseBytes": {"type": "string"},
        "maxBatchItems": {"type": "string"},
        "rateLimitPerMinute": {"type": "string"},
        "strictReadiness": {"type": "string"},
        "corsOrigins": {"type": "string"},
        "statsdHost": {"type": "string"},
        "statsdPort": {"type": "string", "pattern": "^[0-9]+$"},
        "otelTracesEndpoint": {"type": "string"},
        "otelServiceName": {"type": "string", "minLength": 1},
        "otelSampleRatio": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"}
      }
    },
    "extraEnv": {"type": "array"},
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]}
      }
    },
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  }
}
