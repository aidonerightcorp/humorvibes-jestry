{"_meta": {"name": "harvest_wq_multilang_20260724_19", "n": 28, "created": "2026-07-24T12:12:40", "note": "provenance per record; licensing-clean sources only"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Ако го беше направил ти, нямаше да се хваля аз.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Ако забележиш, че конят под тебе се е гътнал, слез от него.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Ако искаш да летиш като орел, недей да ровиш като пуйка.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Ако искаш добре свършена работа, свършѝ си я сам.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Ако не вдигаш прах, ще потънеш в прах.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Ако работата си заслужава – свършѝ я добре.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Времето да се поправи покривът е, когато грее най-ярко слънце.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Впрегни звезда в каретата си и потегляй.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Една лопата и една добра дума никога не бива да се оставят да ръждясват.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "За хубавото трябва да се чака.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Избирай си приятел без да бързаш, а още по-малко бързай да го сменяш.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Каймакът сам се издига към върха.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Картите вече са раздадени, оттук нататък можеш само да ги отиграеш по възможно най-добрия начин.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Който бързо преценява, после дълго съжалява.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Наблюдаваното гърне никога не завира.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Научава го по трудния начин.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Не замеряй с камъни, ако живееш в стъклена къща.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Не можеш да върнеш разбитите яйца в черупките им.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Не можеш да събудиш човек, който се прави, че спи.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Не отваряй вратата на този, който сам посяга да си я отвори.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Не стреляйте по пианиста: толкоз може – толкоз свири.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Никога не съдѝ за книгата по корицата.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Няма значение каква е котката – дали е черна или бяла – важното е да хваща мишки.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Пазѝ си гърба.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Размърдай си задника.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Ритник отзад означава крачка напред.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Стреляй към луната, дори и да пропуснеш, пак ще свалиш някоя звезда.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
{"source": "bg.wikiquote:Американски пословици и поговорки", "license": "CC BY-SA (Wikiquote)", "text": "Шансът е да се окажеш на подходящото място в подходящото време.", "meta": {"language": "bg", "page": "Американски пословици и поговорки"}}
